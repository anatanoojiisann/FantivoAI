{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fantivo-ai-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "USER_PREFERENCES",
      "id": "759c0727c90c46bab64a5b3bf5de4d7b"
    }
  ],
  "services": [
    {
      "binding": "ADMIN_SERVICE",
      "service": "aurax-admin-service"
    }
  ],
  "vars": {
    "OPEN_PLATFORM_BASE_URL": "https://api.aurax.one/tgbot",
    "PUBLIC_WORKER_URL": "https://fantivo-ai-bot.aurax-ai-telegram-bot.workers.dev",
    "PUBLIC_TELEGRAM_BOT_USERNAME": "fantivo_bot",
    "PUBLIC_TELEGRAM_APP_NAME": "app",
    "DEFAULT_MODEL": "peach-max",
    "TELEGRAM_INIT_DATA_MAX_AGE_SECONDS": "86400"
  }
}
