{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "aurax-admin-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "observability": { "enabled": true },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/index.html", "/api/*", "/media/*", "/mcp", "/.well-known/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aurax-admin",
      "database_id": "f95a4c6b-397b-4a66-88e3-e4045aeccb8a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "OPEN_PLATFORM_BASE_URL": "https://api.aurax.one/tgbot",
    "POSTHOG_HOST": "https://us.posthog.com",
    "POSTHOG_PROJECT_ID": "541838",
    "OPENAI_MODEL": "gpt-5.6",
    "MCP_RESOURCE_URL": "https://aurax-admin-service.aurax-ai-telegram-bot.workers.dev/mcp",
    "MCP_OAUTH_ISSUER": "https://dev-eu3fq152wgcapkqo.us.auth0.com/",
    "MCP_OAUTH_AUDIENCE": "https://aurax-admin-service.aurax-ai-telegram-bot.workers.dev/mcp",
    "MCP_OAUTH_JWKS_URL": "https://dev-eu3fq152wgcapkqo.us.auth0.com/.well-known/jwks.json",
    "ADMIN_USERNAME": "lz890699@gmail.com",
    "ADMIN_TOTP_REQUIRED": "false",
    "MEDIA_SOURCE_HOSTS": "api.aurax.one"
  }
}
